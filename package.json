{
	"name": "python-image-preview",
	"displayName": "Python Image Preview",
	"description": "%description%",
	"version": "1.2.0",
	"publisher": "076923",
	"license": "SEE LICENSE IN LICENSE.md",
	"engines": {
		"vscode": "^1.90.0"
	},
	"extensionKind": [
		"workspace"
	],
	"icon": "images/brand/icon.png",
	"galleryBanner": {
		"color": "#1a2038",
		"theme": "dark"
	},
	"categories": [
		"Debuggers",
		"Data Science",
		"Machine Learning",
		"Visualization"
	],
	"keywords": [
		"python",
		"image",
		"numpy",
		"pillow",
		"opencv",
		"matplotlib",
		"pyplot",
		"figure",
		"seaborn",
		"plotly",
		"imageio",
		"scikit-image",
		"skimage",
		"tensorflow",
		"pytorch",
		"jax",
		"cupy",
		"pandas",
		"simpleitk",
		"nibabel",
		"bokeh",
		"altair",
		"preview",
		"debug",
		"debugpy",
		"xarray",
		"dask",
		"torchvision"
	],
	"repository": {
		"type": "git",
		"url": "https://github.com/076923/python-image-preview"
	},
	"bugs": {
		"url": "https://github.com/076923/python-image-preview/issues"
	},
	"qna": "https://github.com/076923/python-image-preview/issues",
	"activationEvents": [
		"onDebugResolve:python",
		"onDebugResolve:debugpy"
	],
	"main": "./dist/extension.js",
	"contributes": {
		"commands": [
			{
				"command": "pythonImagePreview.preview",
				"title": "%command.preview.title%",
				"category": "Python Image Preview",
				"enablement": "inDebugMode && editorLangId == python"
			},
			{
				"command": "pythonImagePreview.previewDefault",
				"title": "%command.previewDefault.title%",
				"category": "Python Image Preview",
				"enablement": "inDebugMode && editorLangId == python"
			},
			{
				"command": "pythonImagePreview.previewVariable",
				"title": "%command.previewVariable.title%",
				"category": "Python Image Preview",
				"enablement": "inDebugMode"
			},
			{
				"command": "pythonImagePreview.inspectVariable",
				"title": "%command.inspectVariable.title%",
				"category": "Python Image Preview",
				"enablement": "inDebugMode"
			},
			{
				"command": "pythonImagePreview.render",
				"title": "%command.render.title%",
				"category": "Python Image Preview"
			},
			{
				"command": "pythonImagePreview.inspect",
				"title": "%command.inspect.title%",
				"category": "Python Image Preview"
			},
			{
				"command": "pythonImagePreview.openSettings",
				"title": "%command.openSettings.title%",
				"category": "Python Image Preview"
			},
			{
				"command": "pythonImagePreview.clearCache",
				"title": "%command.clearCache.title%",
				"category": "Python Image Preview"
			}
		],
		"menus": {
			"editor/context": [
				{
					"command": "pythonImagePreview.preview",
					"when": "inDebugMode && editorLangId == python",
					"group": "navigation@50"
				},
				{
					"command": "pythonImagePreview.previewDefault",
					"when": "inDebugMode && editorLangId == python",
					"group": "navigation@51"
				}
			],
			"debug/variables/context": [
				{
					"command": "pythonImagePreview.previewVariable",
					"when": "debugType =~ /^(python|debugpy)$/",
					"group": "navigation@50"
				},
				{
					"command": "pythonImagePreview.inspectVariable",
					"when": "debugType =~ /^(python|debugpy)$/",
					"group": "navigation@51"
				}
			],
			"commandPalette": [
				{
					"command": "pythonImagePreview.previewVariable",
					"when": "false"
				},
				{
					"command": "pythonImagePreview.render",
					"when": "false"
				},
				{
					"command": "pythonImagePreview.inspect",
					"when": "false"
				},
				{
					"command": "pythonImagePreview.inspectVariable",
					"when": "false"
				}
			],
			"explorer/context": [
				{
					"command": "pythonImagePreview.inspect",
					"when": "resourceExtname =~ /\\.(png|jpg|jpeg|gif|bmp|webp)$/i",
					"group": "navigation@60"
				}
			]
		},
		"configuration": {
			"title": "%config.title%",
			"properties": {
				"pythonImagePreview.cacheDirectory": {
					"order": 1,
					"type": "string",
					"default": "",
					"markdownDescription": "%config.cacheDirectory.markdownDescription%"
				},
				"pythonImagePreview.keepHistory": {
					"order": 2,
					"type": "boolean",
					"default": false,
					"markdownDescription": "%config.keepHistory.markdownDescription%"
				},
				"pythonImagePreview.clearOnSessionEnd": {
					"order": 3,
					"type": "boolean",
					"default": true,
					"description": "%config.clearOnSessionEnd.description%"
				},
				"pythonImagePreview.openBeside": {
					"order": 4,
					"type": "boolean",
					"default": true,
					"description": "%config.openBeside.description%"
				},
				"pythonImagePreview.viewer": {
					"order": 5,
					"type": "string",
					"enum": [
						"image",
						"inspector"
					],
					"default": "image",
					"markdownEnumDescriptions": [
						"%config.viewer.markdownEnumDescriptions.0%",
						"%config.viewer.markdownEnumDescriptions.1%"
					],
					"markdownDescription": "%config.viewer.markdownDescription%"
				},
				"pythonImagePreview.arrayRenderer": {
					"order": 6,
					"type": "string",
					"enum": [
						"matplotlib",
						"opencv"
					],
					"default": "matplotlib",
					"markdownEnumDescriptions": [
						"%config.arrayRenderer.markdownEnumDescriptions.0%",
						"%config.arrayRenderer.markdownEnumDescriptions.1%"
					],
					"markdownDescription": "%config.arrayRenderer.markdownDescription%"
				},
				"pythonImagePreview.grayscaleColormap": {
					"order": 7,
					"type": "string",
					"default": "gray",
					"markdownDescription": "%config.grayscaleColormap.markdownDescription%"
				},
				"pythonImagePreview.hoverPreview": {
					"order": 8,
					"type": "boolean",
					"default": true,
					"markdownDescription": "%config.hoverPreview.markdownDescription%"
				},
				"pythonImagePreview.hoverThumbnailWidth": {
					"order": 9,
					"type": "number",
					"default": 320,
					"minimum": 64,
					"maximum": 800,
					"description": "%config.hoverThumbnailWidth.description%"
				},
				"pythonImagePreview.hoverThumbnailHeight": {
					"order": 10,
					"type": "number",
					"default": 120,
					"minimum": 48,
					"maximum": 600,
					"description": "%config.hoverThumbnailHeight.description%"
				},
				"pythonImagePreview.inlineThumbnails": {
					"order": 11,
					"type": "boolean",
					"default": true,
					"markdownDescription": "%config.inlineThumbnails.markdownDescription%"
				},
				"pythonImagePreview.inlineThumbnailHeight": {
					"order": 12,
					"type": "number",
					"default": 0,
					"minimum": 0,
					"maximum": 48,
					"markdownDescription": "%config.inlineThumbnailHeight.markdownDescription%"
				},
				"pythonImagePreview.inlineThumbnailLimit": {
					"order": 13,
					"type": "number",
					"default": 40,
					"minimum": 1,
					"maximum": 500,
					"description": "%config.inlineThumbnailLimit.description%"
				},
				"pythonImagePreview.inlineValues": {
					"order": 14,
					"type": "string",
					"enum": [
						"images",
						"all",
						"off"
					],
					"default": "off",
					"markdownEnumDescriptions": [
						"%config.inlineValues.markdownEnumDescriptions.0%",
						"%config.inlineValues.markdownEnumDescriptions.1%",
						"%config.inlineValues.markdownEnumDescriptions.2%"
					],
					"markdownDescription": "%config.inlineValues.markdownDescription%"
				}
			}
		},
		"keybindings": [
			{
				"command": "pythonImagePreview.previewDefault",
				"key": "ctrl+alt+p",
				"mac": "cmd+alt+p",
				"when": "inDebugMode && editorTextFocus && editorLangId == python"
			}
		]
	},
	"scripts": {
		"vscode:prepublish": "npm run package",
		"compile": "npm run check-types && npm run lint && node esbuild.mjs",
		"watch": "npm-run-all -p watch:*",
		"watch:esbuild": "node esbuild.mjs --watch",
		"watch:tsc": "tsc --noEmit --watch -p ./",
		"package": "npm run check-types && npm run lint && node esbuild.mjs --production",
		"check-types": "tsc --noEmit -p ./",
		"lint": "eslint src",
		"pretest": "tsc -p ./ && npm run lint",
		"test": "vscode-test",
		"vsix": "vsce package --out vsix/ && node -e \"const f=require('fs'),v=require('./package.json').version;f.renameSync('vsix/python-image-preview-'+v+'.vsix','vsix/076923.python-image-preview-'+v+'.vsix')\""
	},
	"devDependencies": {
		"@types/mocha": "^10.0.10",
		"@types/node": "^20.19.0",
		"@types/vscode": "^1.90.0",
		"@vscode/test-cli": "^0.0.15",
		"@vscode/test-electron": "^3.1.0",
		"@vscode/vsce": "^3.6.0",
		"esbuild": "^0.28.0",
		"eslint": "^9.39.0",
		"npm-run-all": "^4.1.5",
		"typescript": "^5.9.0",
		"typescript-eslint": "^8.72.0"
	}
}
